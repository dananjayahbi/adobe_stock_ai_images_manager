# Data directories (created at runtime)
/data/
backend/storage/
storage/

# Downloaded model weights (~3.4 GB). Kept in the workspace so they can be
# copied to another machine, but never committed — see backend/services/model_paths.py.
models/

# Python
backend/.venv/
__pycache__/
*.pyc
*.pyo
.env

# Node
frontend/node_modules/
.next/
# Machine-specific frontend config (ports differ per machine).
.env.local

# Crash dumps
*.stackdump

# Flutter (mobile/) — mobile/.gitignore covers most; kept at root as defaults
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/*.iml
# Web smoke-test artifact: `flutter build web` output copied to
# frontend-new/public/flutter/ so the app runs from the Next origin
# (CORS allow-listed). Regenerate anytime — never committed.
frontend-new/public/flutter/

# Local run logs and incremental build caches
*.log
*.tsbuildinfo

# Scratch output from `npm run verify:reducer` (tsc emits compiled JS here).
# Ignored because it is regenerated by the script: leaving it tracked makes every
# verification run dirty the working tree with build artefacts.
frontend/.tmp-reducer/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

/backend/upscayl-2.15.0/