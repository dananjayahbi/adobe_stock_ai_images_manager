# Copy to .env.local and adjust if the ports clash with another project.
#
# NEXT_PUBLIC_API_BASE_URL must match the backend's port (BACKEND_PORT in
# backend/config.py). PORT is the Next.js dev-server port and must be listed in
# the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
PORT=3100
