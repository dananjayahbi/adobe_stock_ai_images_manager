# ─── Server / CORS ─────────────────────────────────────────────────
# Port the API listens on (uvicorn --port must match).
BACKEND_PORT=8100
# Origins allowed to call the API. The frontend dev server runs on a
# non-default port, so it must be listed here or the browser blocks its
# requests. Accepts a JSON array or a comma-separated string.
CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# ─── LLM gateway (OpenAI-compatible) ───────────────────────────────
# Defaults target the local multi-provider router:
#   POST {LLM_BASE_URL}/chat/completions   (routes by virtual model name)
LLM_BASE_URL=http://localhost:4006/api/gateway/v1
LLM_MODEL=OpenRouter-Free-Endpoint
# Pool gateway key from the router UI (a per-pool key, or the unified key).
LLM_API_KEY=your_gateway_key_here
LLM_TIMEOUT_SECONDS=240
# Images are downscaled to this longest edge before being sent.
LLM_IMAGE_MAX_DIM=1024

# Legacy Gemini key. Only used if LLM_API_KEY is left empty.
# GEMINI_API_KEY=

# Storage directories and DB path are NOT set here on purpose.
# Their defaults in config.py resolve relative to the repo root, which is
# correct regardless of the working directory. Overriding them with relative
# paths below would resolve against the shell's CWD and break the app.
#
# Per-platform layout: every platform owns a dedicated directory holding ITS
# data dirs and ITS database (zero data leakage between platforms). Adobe
# Stock — the only platform wired today — is the default:
#   INBOX_DIR=<repo_root>/storage/platforms/adobe_stock/inbox
#   THUMBNAILS_DIR=<repo_root>/storage/platforms/adobe_stock/thumbnails
#   READY_DIR=<repo_root>/storage/platforms/adobe_stock/ready_to_upload
#   DB_PATH=<repo_root>/storage/platforms/adobe_stock/adobe_stock.db
# app_settings.json stays at <repo_root>/storage/ — it is app-level operator
# configuration shared across platforms, NOT platform data.
#
# INBOX_DIR=<repo_root>/storage/platforms/adobe_stock/inbox
# THUMBNAILS_DIR=<repo_root>/storage/platforms/adobe_stock/thumbnails
# READY_DIR=<repo_root>/storage/platforms/adobe_stock/ready_to_upload
# DB_PATH=<repo_root>/storage/platforms/adobe_stock/adobe_stock.db

# ─── Authentication (optional) ─────────────────────────────────────
# Documented here for the auth layer; enable by setting these in .env.
# When AUTH_ENABLED=true, the API requires a session cookie
# (cookie name: studio_session) obtained from the login endpoint.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Generate a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_SESSION_TTL_HOURS=24

# QC Thresholds
MIN_MEGAPIXELS=4.0
RECOMMENDED_MEGAPIXELS=12.0
MIN_LAPLACIAN_VARIANCE=120.0
MIN_SEMANTIC_CONFIDENCE=0.75
MIN_FILE_SIZE_MB=5
MAX_FILE_SIZE_MB=35
ABSOLUTE_MAX_FILE_SIZE_MB=45
